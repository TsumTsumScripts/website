{
  "name": "tsum-tsum-website",
  "version": "0.0.0",
  "private": true,
  "description": "The Tsum Tsum script website: landing page, features, changelog, starter tool and contributor docs.",
  "scripts": {
    "docusaurus": "docusaurus",
    "sync": "node scripts/sync-docs.js && node scripts/sync-changelog.js && node scripts/media-plan.js",
    "prestart": "npm run sync",
    "start": "docusaurus start",
    "prebuild": "npm run sync",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "refs:check": "node scripts/check-refs.js --images && node scripts/media-plan.js --check",
    "typecheck": "tsc",
    "media:plan": "node scripts/media-plan.js",
    "media:check": "node scripts/media-plan.js --check",
    "capture": "node capture/run.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@saucelabs/theme-github-codeblock": "0.3.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.15"
  }
}
